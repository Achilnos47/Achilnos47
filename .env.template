# Market Intelligence MCP API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# Reddit API Credentials
# ============================================
# Get these from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=MarketIntel/1.0

# ============================================
# Search and News API Keys
# ============================================
# Tavily Search API (free tier available)
# Get from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google News API (optional, for enhanced news search)
GOOGLE_NEWS_API_KEY=your_google_news_api_key_here

# ============================================
# App Store Intelligence APIs
# ============================================
# Apple App Store Connect API
# Get from: https://appstoreconnect.apple.com/access/api
APP_STORE_CONNECT_KEY=your_app_store_connect_key_here
APP_STORE_CONNECT_KEY_ID=your_key_id_here
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id_here

# Google Play Developer API
# Get from: https://developers.google.com/android-publisher
GOOGLE_PLAY_API_KEY=your_google_play_api_key_here
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here

# ============================================
# Additional API Keys (Optional)
# ============================================
# OpenAI API Key (for enhanced sentiment analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for advanced text analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alpha Vantage API Key (for financial data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================
# Database Configuration (Optional)
# ============================================
# For storing historical data and analysis results
DATABASE_URL=sqlite:///market_intelligence.db

# ============================================
# Notification Settings (Optional)
# ============================================
# Slack webhook for alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Email settings for reports
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email_username_here
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=your_email_from_here

# ============================================
# Analysis Configuration
# ============================================
# Default subreddits for analysis (comma-separated)
DEFAULT_SUBREDDITS=startups,entrepreneur,investing,stocks,technology,SaaS,business

# Default analysis time ranges
DEFAULT_TIME_RANGE_DAYS=30
DEFAULT_POST_LIMIT=100

# Sentiment analysis thresholds
SENTIMENT_POSITIVE_THRESHOLD=0.1
SENTIMENT_NEGATIVE_THRESHOLD=-0.1

# ============================================
# Rate Limiting Configuration
# ============================================
# Reddit API rate limits (requests per minute)
REDDIT_RATE_LIMIT=60

# News API rate limits
NEWS_RATE_LIMIT=100

# App Store API rate limits
APP_STORE_RATE_LIMIT=50